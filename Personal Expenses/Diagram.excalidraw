      "seed": 1000930564,
      "version": 1385,
      "versionNonce": 1480341974,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794506253255,
      "created": 1793992467960,
      "link": null,
      "locked": false,
      "text": "MEASURES:\n\nCálculo de capacidad por persona \n((Capacidad real x persona =\nAvailable_workday_capacity)*working_days) -\nAbsenteeism hours\n        \ncapacidad teorica        \n\nCapacidad real total = \n                VAR turno= current turno\n                CALCULATETABLE(distinct count(analista),\nturno)\n                X CALCULATE(min(columna calculada),turno)\n\nEficiencia = capacidad real total / capacidad teorica\n\nKPI Overtime per analyst prom day\n\nKPI Absenteeism per analyst prom day\n\nTime intelligence\n- comparación versus el mes del año anterior\n- comparación global del año anterior\n\n\n",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "fiMhiCBRouaMARUWZrbQR",
      "originalText": "MEASURES:\n\nCálculo de capacidad por persona \n((Capacidad real x persona = Available_workday_capacity)*working_days) - Absenteeism hours\n        \ncapacidad teorica        \n\nCapacidad real total = \n                VAR turno= current turno\n                CALCULATETABLE(distinct count(analista),  turno)\n                X CALCULATE(min(columna calculada),turno)\n\nEficiencia = capacidad real total / capacidad teorica\n\nKPI Overtime per analyst prom day\n\nKPI Absenteeism per analyst prom day\n\nTime intelligence\n- comparación versus el mes del año anterior\n- comparación global del año anterior\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
