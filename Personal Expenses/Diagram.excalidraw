    {
      "id": "AwzUMjH6WArr6aaQEHekl",
      "type": "text",
      "x": 3449.5629073819473,
      "y": 1396.2159316898392,
      "width": 448.11163330078125,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1971c2",
